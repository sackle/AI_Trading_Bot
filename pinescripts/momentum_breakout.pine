//@version=5
strategy("Momentum Breakout [Aegis]", overlay=true)

lookback = input.int(20, title="Lookback Period")
vol_mult = input.float(1.5, title="Volume Multiplier")
atr_length = input.int(14, title="ATR Length")

highest_high = ta.highest(high[1], lookback)
lowest_low = ta.lowest(low[1], lookback)
avg_vol = ta.sma(volume, lookback)

plot(highest_high, color=color.green, title="Resistance")
plot(lowest_low, color=color.red, title="Support")

longCondition = close > highest_high and volume > (avg_vol * vol_mult)
shortCondition = close < lowest_low and volume > (avg_vol * vol_mult)

webhook_secret = input.string("your_secure_webhook_secret_here", title="Webhook Secret")
qty = input.int(100, title="Quantity")

long_payload = str.format('{{"passphrase": "{0}", "symbol": "{1}", "action": "BUY", "strategy": "momentum_breakout", "price": {2,number,#.##}, "qty": {3}}}', webhook_secret, syminfo.ticker, close, qty)
short_payload = str.format('{{"passphrase": "{0}", "symbol": "{1}", "action": "SELL", "strategy": "momentum_breakout", "price": {2,number,#.##}, "qty": {3}}}', webhook_secret, syminfo.ticker, close, qty)
exit_payload = str.format('{{"passphrase": "{0}", "symbol": "{1}", "action": "CLOSE", "strategy": "momentum_breakout", "price": {2,number,#.##}, "qty": {3}}}', webhook_secret, syminfo.ticker, close, qty)

if (longCondition)
    strategy.entry("Long", strategy.long, alert_message=long_payload)

if (shortCondition)
    strategy.entry("Short", strategy.short, alert_message=short_payload)

// Exit on trailing stop (using ATR or simple opposite channel breakout)
if (strategy.position_size > 0 and close < lowest_low)
    strategy.close("Long", alert_message=exit_payload)

if (strategy.position_size < 0 and close > highest_high)
    strategy.close("Short", alert_message=exit_payload)
