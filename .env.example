# Copy this file to .env (same folder) and fill in your own Alpaca keys.
# Never commit the real .env file to version control.
#
# Paper trading keys:  https://app.alpaca.markets/paper/dashboard/overview
# Live trading keys:   https://app.alpaca.markets/live/dashboard/overview

ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# true  = paper trading (default -- no real money, test everything here first)
# false = live trading with real money
ALPACA_PAPER=true

# The same live equity data feed is used by REST bars and WebSocket updates.
# IEX is generally available; use sip only if your Alpaca subscription allows it.
ALPACA_DATA_FEED=iex

# Analyst & Watchdog
ANALYST_ENABLED=true
ANALYST_INTERVAL_SECONDS=300
ANALYST_MAX_RUNTIME_SECONDS=20
ANALYST_SIGNAL_TTL_SECONDS=300
# auto = XGBoost if installed, else weighted average; also: xgboost | weighted
ANALYST_AGGREGATOR_MODE=auto
WATCHDOG_ENABLED=true
WATCHDOG_HEALTH_CHECK_INTERVAL=300
WATCHDOG_ALERT_WEBHOOK_URL=
WATCHDOG_MEMORY_LIMIT_MB=2048

# Adaptive loop cadence (faster in HIGH_VOLATILITY, slower in MEAN_REVERTING)
ADAPTIVE_LOOP_CADENCE=true

# Bayesian strategy parameter tuning (requires optuna; skipped if missing)
OPTIMIZER_ENABLED=true
OPTIMIZER_REFIT_INTERVAL_DAYS=7
OPTIMIZER_MAX_TRIALS=50

# Broker backend: Alpaca's paper/live account, or local virtual-paper orders
# backed by Alpaca market data. IBKR is not implemented.
BROKER_BACKEND=alpaca

# Historical-data / market-clock cache durations. Keep these below the
# smallest trading candle so the bot processes fresh data without duplicate
# API requests.
MARKET_DATA_CACHE_TTL_SECONDS=8
MARKET_CLOCK_CACHE_TTL_SECONDS=15
DASHBOARD_ACCOUNT_REFRESH_SECONDS=15
DASHBOARD_BARS_REFRESH_SECONDS=300

# Supervised US + NSE runtime. A worker heartbeat that goes stale is visible
# in the dashboard and pauses new entries until all workers recover.
WORKER_HEARTBEAT_TTL_SECONDS=180
WORKER_SUPERVISOR_POLL_SECONDS=1
BROKER_REQUEST_TIMEOUT_SECONDS=10
WORKER_RESTART_BACKOFF_SECONDS=2
WORKER_MAX_RESTARTS=5
WORKER_SHUTDOWN_TIMEOUT_SECONDS=20
PAUSE_ALL_ON_WORKER_FAILURE=true

# NSE is always simulated locally in this project. Its cash, positions, and
# protective-stop metadata persist in runtime/nse_paper_state.json.
NSE_ENABLED=true
NSE_PAPER_EQUITY=500000
NSE_LOOP_INTERVAL_SECONDS=60
NSE_DATA_WORKERS=6

# Optional local Ollama advisors. Disabled by default so an unavailable LLM
# cannot stall a strategy entry. Set either to true only after verifying the
# local model service.
AI_COMMITTEE_ENABLED=false
AI_VIRTUAL_BRAIN_ENABLED=false
AI_AGENT_TIMEOUT_SECONDS=8
AI_AGENT_FAILURE_POLICY=continue

# The red/green strategy is opt-in and may not overlap another strategy's
# symbols (the portfolio supports one strategy owner per underlying).
RED_GREEN_BREAKOUT_ENABLED=false
RED_GREEN_BREAKOUT_SYMBOLS=

# TradingView Integration
TRADINGVIEW_ENABLED=false
# Generate a private 256-bit value with: openssl rand -hex 32
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_PUBLIC_URL=
TRADINGVIEW_WEBHOOK_HOST=127.0.0.1
TRADINGVIEW_WEBHOOK_PORT=8080
TRADINGVIEW_SIGNAL_MODE=supplement

